# Copy to .env (never commit the real file). Use Supabase's transaction pooler.
# Use the Supabase transaction-pooler URI from your project (port 6543).
DATABASE_URL=

# Live tests and seeding stay disabled until all allowlists identify an isolated
# Supabase development database. Never use a production database here.
INVENTORY_POSTGRES_TESTS=0
INVENTORY_TEST_ENV=
INVENTORY_TEST_ALLOWED_DATABASE_HOST=
INVENTORY_TEST_ALLOWED_DATABASE_USER=
INVENTORY_TEST_ALLOWED_DATABASE_NAME=
INVENTORY_SEED_ENV=
INVENTORY_SEED_ALLOWED_DATABASE_HOST=
INVENTORY_SEED_ALLOWED_DATABASE_USER=
INVENTORY_SEED_ALLOWED_DATABASE_NAME=
# Existing TinyDB/JWT configuration; do not use production secrets in local tests.
SUPPLIER_DB_PATH=./data/suppliers.json
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AUTH-03 password recovery. Email provider: Resend (https://resend.com). Never commit the real key.
# Without RESEND_API_KEY the API still answers /auth/forgot-password generically but sends nothing.
RESEND_API_KEY=
# Without a verified domain, Resend's testing sender only delivers to the Resend account's own address.
EMAIL_FROM=Nexova <onboarding@resend.dev>
RESEND_API_BASE_URL=https://api.resend.com
# Base URL of the backoffice; reset links point to <FRONTEND_BASE_URL>/backoffice/reset-password?token=...
FRONTEND_BASE_URL=http://127.0.0.1:5500
# Reset link lifetime in minutes (allowed range 15-60).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# EXTRA-02 rate limits (sliding one-hour window).
PASSWORD_RESET_MAX_PER_EMAIL_PER_HOUR=3
PASSWORD_RESET_MAX_PER_IP_PER_HOUR=20
