# Copy to .env (never commit the real file). Use Supabase's transaction pooler.
# Use the Supabase transaction-pooler URI from your project (port 6543).
DATABASE_URL=

# Live tests and seeding stay disabled until all allowlists identify an isolated
# Supabase development database. Never use a production database here.
INVENTORY_POSTGRES_TESTS=0
INVENTORY_TEST_ENV=
INVENTORY_TEST_ALLOWED_DATABASE_HOST=
INVENTORY_TEST_ALLOWED_DATABASE_USER=
INVENTORY_TEST_ALLOWED_DATABASE_NAME=
INVENTORY_SEED_ENV=
INVENTORY_SEED_ALLOWED_DATABASE_HOST=
INVENTORY_SEED_ALLOWED_DATABASE_USER=
INVENTORY_SEED_ALLOWED_DATABASE_NAME=
# Existing TinyDB/JWT configuration; do not use production secrets in local tests.
SUPPLIER_DB_PATH=./data/suppliers.json
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
