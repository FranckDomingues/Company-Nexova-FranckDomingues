{
  "name": "nexova-inventory-backoffice",
  "version": "1.0.0",
  "private": true,
  "description": "Nexova backoffice — inventory management (Hito 5)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests e2e serve.cjs jest.config.cjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "serve": "node serve.cjs",
    "e2e": "node e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/jest": "29.5.14",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
